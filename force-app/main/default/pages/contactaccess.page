<apex:page standardController="Contact" extensions="contactlistcontroller">
    <apex:sectionHeader title="Contact" subtitle="Overview List"/>
    <apex:pageBlock title="Contact">
       <!--table componenet to show account list-->
        <apex:pageBlockTable value="{!contactList}" var="con">
            <apex:column headerValue="contact Id">
            <apex:outputLink value="/{!con.Id}">{!con.Name}</apex:outputLink>
        </apex:column>
            
            <apex:column Value="{!con.Birthdate}"/>
            <apex:column Value="{!con.Email}"/>
            <apex:column Value="{!con.Phone}"/>
            
        </apex:pageBlockTable>
        
    </apex:pageBlock>
</apex:page>