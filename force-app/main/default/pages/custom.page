<apex:page controller="CustomStudentController">
    <apex:form >
        <apex:pageBlock title="Student Course Registration">
            <apex:pageMessages />
            <apex:pageBlockSection columns="1">
                <apex:selectList value="{!selectedCourseId}" size="1">
                    <apex:selectOptions value="{!courseOptions}"/>
                </apex:selectList>
                <apex:commandButton value="Show Details" action="{!showCourse}"/>
            </apex:pageBlockSection>
            <apex:pageBlockSection columns="2">
                <apex:outputText value="Course Fee"/>
                <apex:outputText value="{!selectedCourse.Fee__c}"/>
                <apex:outputText value="Duration"/>
                <apex:outputText value="{!selectedCourse.Duration__c}"/>
            </apex:pageBlockSection>
            <apex:commandButton value="Register" action="{!registerStudent}"/>
        </apex:pageBlock>
    </apex:form>
</apex:page>