    <decisions>
        <name>Check_Loan_Application_Status</name>
        <label>Check Loan Application Status</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Approved</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Application_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved,</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Approved_Loan_Task</targetReference>
            </connector>
            <label>Approved</label>
        </rules>
        <rules>
            <name>Rejected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Application_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Rejected</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Rejection_Follow_up_Task</targetReference>
            </connector>
            <label>Rejected</label>
        </rules>
        <rules>
            <name>Under_Review</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Application_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Under Review,</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Review_Task</targetReference>
            </connector>
            <label>Under Review</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
