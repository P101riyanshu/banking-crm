                </rightValue>
            </conditions>
            <connector>
                <targetReference>between_student_records</targetReference>
            </connector>
            <label>between student</label>
        </rules>
        <rules>
            <name>default</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Previoius_Score__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>50.0</numberValue>
                </rightValue>
            </conditions>
